<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 品牌色：与 Flutter 侧 AppColors 保持一致 -->
    <color name="brand_primary">#17635C</color>
    <color name="brand_deep">#0B3A36</color>
    <color name="brand_sand">#C89544</color>
    <color name="ic_launcher_background">#0B3A36</color>
    <!-- 原生启动页底色：与 brand/splash-1080x1920.png 的上下边缘对齐，
         让居中启动图和上下留白之间没有明显的色块接缝。 -->
    <color name="splash_top">#14586B</color>
    <color name="splash_bottom">#062538</color>
    <!-- Android 12+ 系统 SplashScreen 只吃纯色，取渐变中点，切到
         windowBackground 的渐变时不会有明显亮度跳变。 -->
    <color name="splash_mid">#0D3E52</color>
</resources>
