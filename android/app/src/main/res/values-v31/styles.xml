<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 系统强制先铺一层 SplashScreen。它默认居中放应用图标，
         那一帧同样是「小页面」，所以图标换成全透明、动画时长归零，只留与
         windowBackground 同色系的纯色底；正式启动页由 Flutter 全屏绘制。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_mid</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_bottom</item>
    </style>
</resources>
