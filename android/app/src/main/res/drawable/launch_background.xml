<?xml version="1.0" encoding="utf-8"?>
<!-- 冷启动底色：只画深青渐变，不放任何图片。
     旧版在这里居中摆一张由成图裁出的 launch_logo（360dp 宽的整页缩略图），
     冷启动会先闪一帧「小一号的启动页」，Flutter 首帧才换成全屏正式启动页，
     真机上就是「页面先小一下再变大」。现在原生层只负责底色，品牌文字
     全部由 lib/splash_page.dart 全屏矢量绘制，两者同色系，切换无缩放感。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/splash_top"
                android:endColor="@color/splash_bottom" />
        </shape>
    </item>
</layer-list>
